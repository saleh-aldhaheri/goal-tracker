APP_NAME="Goal Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite is the default and only supported driver for this app.
DB_CONNECTION=sqlite
# Absolute or relative path is resolved in config/database.php via database_path().
# DB_DATABASE=/absolute/path/to/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# Comma-separated list of API token abilities available for issuing MCP tokens.
MCP_TOKEN_DEFAULT_ABILITIES="goals:read,goals:write,activities:read,activities:write,dashboard:read"

# Used only by `php artisan db:seed --class=InitialAccountSeeder` to create
# the real production account. Leave INITIAL_USER_PASSWORD unset to have
# the seeder generate and print a random one instead of hardcoding it here.
INITIAL_USER_NAME="Saleh"
INITIAL_USER_EMAIL=saleh@goal-tracker.local
# INITIAL_USER_PASSWORD=
